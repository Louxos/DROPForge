{
  "name": "dropforge",
  "version": "0.1.0",
  "private": true,
  "description": "DropForge — transfert de fichiers entre appareils, sans compte, chiffré de bout en bout.",
  "license": "SEE LICENSE IN docs/LICENSES.md",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/signaling",
    "apps/desktop"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "dev:web": "npm run dev -w @dropforge/web",
    "dev:signaling": "npm run dev -w @dropforge/signaling",
    "build:web": "npm run build -w @dropforge/web",
    "start:signaling": "npm run start -w @dropforge/signaling",
    "verify": "npm run typecheck && npm run typecheck:desktop && npm run test",
    "dev:desktop": "npm run tauri dev -w @dropforge/desktop",
    "build:desktop": "npm run tauri:build -w @dropforge/desktop",
    "icons": "node scripts/generate-icons.mjs",
    "licences": "node scripts/list-licences.mjs",
    "typecheck:desktop": "tsc -p apps/desktop/tsconfig.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "build:signaling": "npm run build -w @dropforge/signaling",
    "build:desktop:frontend": "npm run build -w @dropforge/desktop",
    "build": "npm run build:signaling && npm run build:web && npm run build:desktop:frontend",
    "package": "node scripts/package.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "build:windows": "npm run tauri:build -w @dropforge/desktop"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
