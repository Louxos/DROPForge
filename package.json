{
  "name": "dropforge",
  "version": "0.1.3",
  "private": true,
  "description": "DropForge — transfert de fichiers entre appareils, sans compte, chiffré de bout en bout.",
  "license": "SEE LICENSE IN docs/GUIDE.md",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/signaling"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "check:direct": "tsx scripts/check-direct-path.mts",
    "dev:web": "npm run dev -w @dropforge/web",
    "dev:signaling": "npm run dev -w @dropforge/signaling",
    "build:web": "npm run build -w @dropforge/web",
    "start:signaling": "npm run start -w @dropforge/signaling",
    "verify": "npm run typecheck && npm run check:site && npm run test",
    "icons": "node scripts/generate-icons.mjs",
    "licences": "node scripts/list-licences.mjs",
    "site:build": "node scripts/build-site.mjs",
    "check:site": "node scripts/build-site.mjs --check",
    "dev": "node scripts/dev.mjs",
    "lan": "node scripts/serve-lan.mjs",
    "build:signaling": "npm run build -w @dropforge/signaling",
    "build": "npm run build:signaling && npm run build:web",
    "package": "node scripts/package.mjs",
    "smoke:release": "node scripts/smoke-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
