# Application web (PWA) servie par nginx, avec le service de signalisation relayé
# sur la même origine — c'est ce qui évite toute règle CORS et tout second domaine.
#
# Construction :  docker build -f deploy/Dockerfile.web -t dropforge-web .
# Exécution :     docker run --rm -p 8080:80 dropforge-web
FROM node:22-alpine AS build
WORKDIR /src
# Les sources de tout le dépôt sont nécessaires : les paquets du workspace sont
# consommés en TypeScript, pas précompilés.
COPY . .
RUN npm ci --no-audit --no-fund && npm run build:web

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
