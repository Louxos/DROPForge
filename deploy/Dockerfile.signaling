# Service de signalisation et de relais aveugle.
#
# Construction :  docker build -f deploy/Dockerfile.signaling -t dropforge-signaling .
# Exécution :     docker run --rm -p 8787:8787 dropforge-signaling
FROM node:22-alpine AS build
WORKDIR /src
COPY . .
RUN npm ci --no-audit --no-fund \
 && npm run build:signaling \
 && mkdir -p /out \
 && cp -r apps/signaling/dist /out/dist \
 && printf '%s\n' '{"name":"dropforge-signaling","type":"module","main":"dist/main.js","dependencies":{"ws":"^8.22.0"}}' > /out/package.json \
 && cd /out && npm install --omit=dev --no-audit --no-fund

FROM node:22-alpine
WORKDIR /app
COPY --from=build /out /app
ENV HOST=0.0.0.0 PORT=8787
EXPOSE 8787
USER node
HEALTHCHECK --interval=30s --timeout=5s CMD wget -q -O /dev/null http://127.0.0.1:8787/health || exit 1
CMD ["node", "dist/main.js"]
