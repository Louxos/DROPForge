# Dependencies
node_modules/

# Build output
dist/
build/
out/
dev-dist/
*.tsbuildinfo

# Compiled leftovers next to sources: every package is consumed as TypeScript, so a
# stray .js would silently shadow the source it was compiled from.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
apps/*/src/**/*.js.map

# Release artifacts produced by `npm run package` (never committed)
release/
out/
deploy/.env
dist/

# Site GitHub Pages assemblé par `npm run build:pages` : accueil, page 404 et
# application compilée. Rien de tout cela n'est versionné — le site publié est toujours
# reconstruit à partir des sources, il ne peut donc pas dériver de ce qu'il affiche.
_site/
# Ce que la construction a réellement produit (chemin de base, taille, version) : lu par
# les contrôles, jamais publié.
.pages-build.json

# Test & coverage artifacts
coverage/
.vitest/
test-results/

# Environment & local secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key
!docs/**/*.key.md

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Certificat du mode « même Wi‑Fi » (`npm run lan`) : une clé privée et un certificat
# propres à cette machine, fabriqués localement, jamais publiés.
.lan-tls/

# Local runtime data (transfer spool, dev storage)
.data/
.local-storage/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Playwright
playwright-report/
test-results/
blob-report/
