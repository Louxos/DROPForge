{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropForge",
  "version": "0.1.0",
  "identifier": "org.dropforge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5199",
    "beforeDevCommand": "npm run dev -w @dropforge/desktop",
    "beforeBuildCommand": "npm run build -w @dropforge/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DropForge",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": true,
        "theme": null
      }
    ],
    "trayIcon": {
      "id": "dropforge",
      "iconPath": "icons/icon.png",
      "tooltip": "DropForge",
      "menuOnLeftClick": false,
      "menu": [
        { "id": "show", "text": "Ouvrir DropForge" },
        { "id": "send", "text": "Envoyer un dossier…" },
        { "id": "separator", "text": "-" },
        { "id": "quit", "text": "Quitter" }
      ]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ws: wss: http: https:; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "DropForge",
    "category": "Utility",
    "shortDescription": "Transfert de fichiers entre appareils, chiffré de bout en bout.",
    "longDescription": "DropForge transfère des fichiers entre vos appareils, directement quand c'est possible, chiffrés de bout en bout, sans compte et sans service payant obligatoire.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "dialog": false,
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    },
    "sql": {
      "preload": []
    }
  }
}
